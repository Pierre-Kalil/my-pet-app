<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Personal pet photos are intentionally limited to the explicit local backup flow. -->
    <exclude domain="file" path="pet_photos/" />
    <!-- Onboarding is device-local and must not follow an Android backup. -->
    <exclude domain="file" path="datastore/onboarding.preferences_pb" />
</full-backup-content>
